<Page
    x:Class="StremioCommunity.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">

    <Grid>
        <MediaPlayerElement
            x:Name="Player"
            AreTransportControlsEnabled="False"
            Stretch="Uniform"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

        <!-- Minimal on-screen bar; controller input is handled in code (A/Menu pause, Y audio, X subtitles, D-pad ±10 s, LB/RB ±60 s). -->
        <Grid x:Name="Osd" VerticalAlignment="Bottom" Padding="64,24,64,40" Background="#B3000000" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="OsdTitle" FontSize="22" Foreground="White" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="OsdInfo" FontSize="20" Foreground="#FFD54F" Margin="0,8,0,0" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="OsdProgress" Minimum="0" Maximum="1" Height="6" Margin="0,14,0,10" Foreground="#7B5BF5" />
                <TextBlock x:Name="OsdTime" FontSize="18" Foreground="#CCFFFFFF" />
            </StackPanel>
        </Grid>

        <!-- Audio track picker (Y opens; D-pad moves, A selects, B closes). Populated from the media item. -->
        <Border
            x:Name="AudioMenu"
            Visibility="Collapsed"
            Background="#E6000000"
            BorderBrush="#7B5BF5"
            BorderThickness="2"
            CornerRadius="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="900"
            MinWidth="560"
            Padding="28,20">
            <StackPanel>
                <TextBlock FontSize="24" Foreground="#FFD54F" Margin="0,0,0,14" Text="Audio tracks" />
                <ScrollViewer x:Name="AudioMenuScroll" MaxHeight="640" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="AudioMenuItems" />
                </ScrollViewer>
                <TextBlock FontSize="16" Foreground="#88FFFFFF" Margin="0,16,0,0" Text="D-pad: move   A: select   B: close" />
            </StackPanel>
        </Border>

        <!-- Subtitle picker (X opens; D-pad moves, A selects, B closes). Populated from the media item. -->
        <Border
            x:Name="SubtitleMenu"
            Visibility="Collapsed"
            Background="#E6000000"
            BorderBrush="#7B5BF5"
            BorderThickness="2"
            CornerRadius="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="900"
            MinWidth="560"
            Padding="28,20">
            <StackPanel>
                <TextBlock FontSize="24" Foreground="#FFD54F" Margin="0,0,0,14" Text="Subtitles" />
                <ScrollViewer x:Name="SubtitleMenuScroll" MaxHeight="640" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SubtitleMenuItems" />
                </ScrollViewer>
                <TextBlock FontSize="16" Foreground="#88FFFFFF" Margin="0,16,0,0" Text="D-pad: move (L/R steps the value row)   A: select   B: close" />
            </StackPanel>
        </Border>

        <!-- Controls help overlay (View / Guide opens; B or any other button closes). -->
        <Border
            x:Name="HelpOverlay"
            Visibility="Collapsed"
            Background="#F2000000"
            BorderBrush="#7B5BF5"
            BorderThickness="2"
            CornerRadius="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MaxWidth="900"
            MinWidth="640"
            Padding="36,28">
            <StackPanel>
                <TextBlock FontSize="26" Foreground="#FFD54F" Margin="0,0,0,18" Text="Controls" />
                <Grid ColumnSpacing="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="HelpLeft" Grid.Column="0" />
                    <StackPanel x:Name="HelpRight" Grid.Column="1" />
                </Grid>
                <TextBlock FontSize="16" Foreground="#88FFFFFF" Margin="0,20,0,0" Text="Press B (or any button) to close" />
            </StackPanel>
        </Border>

        <!-- Debug log (F1 / View). Y toggles restart seek; B closes. -->
        <Border
            x:Name="DebugPanel"
            Visibility="Collapsed"
            Background="#E6000000"
            BorderBrush="#7B5BF5"
            BorderThickness="2"
            CornerRadius="8"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="48"
            MaxWidth="1200"
            Padding="16">
            <StackPanel>
                <TextBlock x:Name="DebugHeader" Foreground="#FFD54F" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock x:Name="DebugText" Foreground="White" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
